# =============================================================================
# Secure Student Academic Record Portal - Environment Configuration
# =============================================================================
# Copy this file to .env and customize the values below.
# =============================================================================

# --- Server Configuration ---
PORT=5000
NODE_ENV=production

# --- JWT Configuration ---
# Change this to a random secret in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# --- CORS Configuration ---
CORS_ORIGIN=http://localhost:3000

# --- Database Configuration (SQLite) ---
DATABASE_PATH=./data/academic_portal.db

# --- Default Admin Account ---
# These are the default credentials created on first migration.
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=Admin@123
ADMIN_ROLE=admin
ADMIN_DISPLAY_NAME=System Administrator
ADMIN_EMAIL=admin@your-domain.com

# --- Bravo SMTP Configuration ---
# Get these from your Bravo SMTP dashboard.
# Used for sending OTP verification emails to staff and students.
SMTP_HOST=smtp.bravo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-bravo-smtp-username
SMTP_PASSWORD=your-bravo-smtp-password
SMTP_FROM=noreply@your-domain.com
SMTP_FROM_NAME=Academic Record Portal

# --- Frontend Configuration ---
VITE_API_URL=http://localhost:5000/api
WEB_PORT=3000

# Copy this file to .env in the project root, then replace the placeholder secrets.
DB_USER=postgres
DB_PASSWORD=replace-with-a-unique-local-db-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=/api
WEB_PORT=3000

# SMTP is required when NODE_ENV=production. In development, OTPs appear in backend logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
